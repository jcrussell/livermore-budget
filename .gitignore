# Build output
bin/
dist/

# `go build ./tools/<name>` with no -o drops the binary at the REPO ROOT, named
# for the package. The Makefile uses `go run` and never leaves one, so these
# appear only when someone builds a tool by hand -- and a `git add -A` after
# that sweeps several megabytes into a commit.
# One line per Go main under tools/, plus cmd/fisc. tools/jscheck is .mjs and
# builds nothing.
/beadcheck
/beadrefs
/codehash
/doccheck
/memcheck
/narration
/fisc

# Generated site data (written by `fisc export`, one JSON per projection)
site/data/

# M0 spike scratch (regenerate with docs/m0-spike/spike.py)
docs/m0-spike/spike/

# Beads runtime is governed by .beads/.gitignore -- do not duplicate it here.
# issues.jsonl is a passive export and IS tracked, so the roadmap is readable
# from the git tree without a Dolt checkout.

# Agent worktrees (created by subagents; never part of the tree)
.claude/worktrees/

# Python bytecode. tools/extract.py runs as a script and leaves none, but a
# test that IMPORTS it does -- which is how this arrived.
tools/__pycache__/

# One-shot session handoff (burn after reading)
next
