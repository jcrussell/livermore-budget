{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcrussell.github.io/livermore-budget/schema/projection.schema.json",
  "title": "fisc graph projection",
  "description": "One document internal/project builds as a graph: the citywide spine and the schedules drawn beside it. internal/export decodes it without importing internal/project, so this schema is what couples them.",
  "type": "object",
  "required": ["schema_version", "projection", "metadata", "nodes", "links"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "projection": {
      "description": "A declared set, not an open one: each value is an internal/project constant the export's steps name.",
      "enum": ["sankey", "fund-flows", "department-spending", "department-funding", "transfers-by-fund", "transfers-out", "fund-sources-uses", "expansion"]
    },
    "metadata": {
      "type": "object",
      "required": [
        "generated_by", "fiscal_year", "fiscal_year_label", "basis", "scopes",
        "currency", "units", "sources", "counts", "caveats"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "fiscal_year": { "type": "integer", "minimum": 1900 },
        "fiscal_year_label": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/basis" },
        "scopes": {
          "description": "The schedule set the facts came from, in the projection's own order; one entry on most documents, three on fund-flows.",
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        },
        "currency": { "const": "USD" },
        "units": { "const": "cents" },
        "sources": {
          "type": "array",
          "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
        },
        "headline": {
          "description": "The spine's own figures, which internal/check reconciles against by name; no other document carries the block.",
          "type": "object",
          "required": ["all_funds_gross_revenue_cents", "all_funds_gross_expenditure_cents", "external_revenue_cents", "external_expenditure_cents", "internal_transfer_in_cents", "internal_transfer_out_cents", "naive_expenditure_cents", "transfer_residual_cents"],
          "additionalProperties": false,
          "properties": {
            "all_funds_gross_revenue_cents": { "type": "integer" },
            "all_funds_gross_expenditure_cents": { "type": "integer" },
            "external_revenue_cents": { "type": "integer" },
            "external_expenditure_cents": { "type": "integer" },
            "internal_transfer_in_cents": { "type": "integer" },
            "internal_transfer_out_cents": { "type": "integer" },
            "naive_expenditure_cents": { "type": "integer" },
            "transfer_residual_cents": { "type": "integer" }
          }
        },
        "counts": {
          "description": "How much of the corpus this document accounts for: facts = facts_cited + facts_uncited on every document, and facts_cited_twice is the overlap where a fact is behind more than one link.",
          "type": "object",
          "required": ["facts", "facts_cited", "facts_uncited", "facts_cited_twice", "nodes", "links"],
          "additionalProperties": false,
          "properties": {
            "facts": { "type": "integer", "minimum": 0 },
            "facts_cited": { "type": "integer", "minimum": 0 },
            "facts_uncited": { "type": "integer", "minimum": 0 },
            "facts_cited_twice": { "type": "integer", "minimum": 0 },
            "nodes": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 }
          }
        },
        "caveats": {
          "type": "array",
          "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/caveat.schema.json" }
        }
      }
    },
    "nodes": {
      "description": "Empty is a document, not an error: a projection over facts that select nothing publishes an empty graph. What is refused is a null.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "label", "tier", "parent", "constraint_tier", "role",
          "derived", "rationale", "source_note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "tier": { "type": "integer", "minimum": 0 },
          "parent": { "type": "string" },
          "constraint_tier": { "type": "string" },
          "role": { "type": "string" },
          "derived": { "type": "boolean" },
          "rationale": { "type": "string" },
          "source_note": { "type": "string" },
          "alternative": {
            "description": "On the expansion schedule alone: the key of the alternative split this node is a member of, its parent being that split's node. Absent on a member of the parent's primary split.",
            "type": "string", "minLength": 1
          },
          "balances": {
            "description": "A fund's printed beginning and ending balance in this column, on fund-sources-uses and on the expansion's fund nodes, which carry fund-sources-uses' own, with their change where both are printed. A balance the page leaves blank is absent, not zero, so a node printing neither carries no key at all.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "beginning": {
                "description": "One printed balance, cited as a link cites its figures: one fact, and the page it was read from.",
                "type": "object",
                "required": ["value_cents", "fact_id", "locators"],
                "additionalProperties": false,
                "properties": {
                  "value_cents": { "type": "integer" },
                  "fact_id": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json" },
                  "locators": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
                  }
                }
              },
              "ending": {
                "description": "One printed balance, cited as a link cites its figures: one fact, and the page it was read from.",
                "type": "object",
                "required": ["value_cents", "fact_id", "locators"],
                "additionalProperties": false,
                "properties": {
                  "value_cents": { "type": "integer" },
                  "fact_id": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json" },
                  "locators": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
                  }
                }
              },
              "change": {
                "description": "Our subtraction, never printed: ending less beginning of the two balances beside it, stated only where both are printed, citing both facts. A zero is stated, and a blank balance states none.",
                "type": "object",
                "required": ["value_cents", "derived", "rationale", "source_note", "fact_ids", "locators"],
                "additionalProperties": false,
                "properties": {
                  "value_cents": { "type": "integer" },
                  "derived": { "const": true },
                  "rationale": { "type": "string", "minLength": 1 },
                  "source_note": { "type": "string", "minLength": 1 },
                  "fact_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json" }
                  },
                  "locators": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "splits": {
      "description": "The expansion schedule's alone: each way a node opens. A node's members are the nodes parented to it whose alternative is the split's key on an alternative split, or absent on its primary one.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "key", "form", "alternative"],
        "additionalProperties": false,
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "form": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/split_form" },
          "alternative": { "type": "boolean" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source", "target", "value_cents", "kind", "transfer_id",
          "fact_ids", "locators", "derived", "partition", "contra"
        ],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "value_cents": {
            "description": "Integer cents as printed, signed: a contra row, printed in parentheses, arrives negative.",
            "type": "integer"
          },
          "kind": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/link_kind" },
          "transfer_id": { "type": "string" },
          "fact_ids": {
            "type": "array",
            "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json" }
          },
          "locators": {
            "type": "array",
            "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
          },
          "derived": { "type": "boolean" },
          "partition": { "type": "boolean" },
          "contra": {
            "description": "The schedule this link is printed as a reduction of, in the words the page shows beside it. Empty on every link the document does not print negative.",
            "type": "string"
          },
          "alternative": {
            "description": "On the expansion schedule alone: the key of the alternative split this is a leaf link of, drawn only while a reader has that split open. Absent on a primary link.",
            "type": "string", "minLength": 1
          },
          "completes": {
            "description": "On the expansion schedule alone: the spine cell this primary link re-forms with every other link naming it, spelt '<source> -> <target> <kind>', where a derived leg folds into a printed cell. Exactly that set of legs is the printed figure, and any part of it is not. Absent on every other link.",
            "type": "string", "pattern": "^\\S+ -> \\S+ \\S+$"
          },
          "repeats": {
            "description": "On the expansion schedule alone: the one leaf link this link is drawn from, spelt at that leaf's own ends as '<source> -> <target> <kind>'. A hub leg from an extended node to its member carries that leaf's cents and facts again; the leaf itself names its own ends, one of which may be moved onto the extended node. Absent on every other link.",
            "type": "string", "pattern": "^\\S+ -> \\S+ \\S+$"
          },
          "restates": {
            "description": "On the expansion schedule alone: the leaves a link from a totals split's node to its member states again, each spelt as its repeats spells it, ascending. Fund/100's divisions name each division's onward leaves; an object category's divisions each name every leaf arriving at the category, since no one division is one leaf. The links naming one list carry those leaves' cents together. Absent on every other link.",
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\S+ -> \\S+ \\S+$" }
          }
        },
        "allOf": [
          {
            "description": "A published link cites at least one fact and names where it was read; a derived one cites nothing, because no page prints it.",
            "if": { "properties": { "derived": { "const": false } } },
            "then": {
              "properties": {
                "fact_ids": { "minItems": 1 },
                "locators": { "minItems": 1 }
              }
            }
          },
          {
            "description": "A negative figure names the schedule it reduces, and only a negative one does.",
            "if": { "properties": { "value_cents": { "exclusiveMaximum": 0 } }, "required": ["value_cents"] },
            "then": { "properties": { "contra": { "minLength": 1 } } },
            "else": { "properties": { "contra": { "const": "" } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "description": "A document that draws something says where it read it. An empty projection may cite nothing; one with nodes and no sources may not.",
      "if": { "properties": { "nodes": { "minItems": 1 } }, "required": ["nodes"] },
      "then": { "properties": { "metadata": { "properties": { "sources": { "minItems": 1 } } } } }
    },
    {
      "description": "THE HEADLINE IS THE SPINE'S ALONE: its keys are citywide totals and mean nothing on a schedule drawn over part of the city.",
      "if": { "properties": { "projection": { "const": "sankey" } }, "required": ["projection"] },
      "then": { "properties": { "metadata": { "required": ["headline"] } } },
      "else": { "properties": { "metadata": { "not": { "required": ["headline"] } } } }
    }
  ]
}
