{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcrussell.github.io/livermore-budget/schema/projection.schema.json",
  "title": "fisc graph projection",
  "description": "One document internal/project builds as a graph: the citywide spine and the schedules drawn beside it. internal/export decodes it without importing internal/project, so this schema is what couples them.",
  "type": "object",
  "required": ["schema_version", "projection", "metadata", "nodes", "links"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "projection": {
      "description": "A declared set, not an open one: each value is an internal/project constant the export's steps name.",
      "enum": ["sankey", "fund-flows", "department-spending", "department-funding", "transfers-by-fund", "transfers-out"]
    },
    "metadata": {
      "type": "object",
      "required": [
        "generated_by", "fiscal_year", "fiscal_year_label", "basis", "scopes",
        "currency", "units", "sources", "counts", "caveats"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "fiscal_year": { "type": "integer", "minimum": 1900 },
        "fiscal_year_label": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/basis" },
        "scopes": {
          "description": "The schedule set the facts came from, in the projection's own order; one entry on most documents, three on fund-flows.",
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        },
        "currency": { "const": "USD" },
        "units": { "const": "cents" },
        "sources": {
          "type": "array",
          "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
        },
        "headline": {
          "description": "The spine's own figures, which internal/check reconciles against by name; no other document carries the block.",
          "type": "object",
          "required": ["all_funds_gross_revenue_cents", "all_funds_gross_expenditure_cents", "external_revenue_cents", "external_expenditure_cents", "internal_transfer_in_cents", "internal_transfer_out_cents", "naive_expenditure_cents", "transfer_residual_cents"],
          "additionalProperties": false,
          "properties": {
            "all_funds_gross_revenue_cents": { "type": "integer" },
            "all_funds_gross_expenditure_cents": { "type": "integer" },
            "external_revenue_cents": { "type": "integer" },
            "external_expenditure_cents": { "type": "integer" },
            "internal_transfer_in_cents": { "type": "integer" },
            "internal_transfer_out_cents": { "type": "integer" },
            "naive_expenditure_cents": { "type": "integer" },
            "transfer_residual_cents": { "type": "integer" }
          }
        },
        "counts": {
          "description": "How much of the corpus this document accounts for: facts = facts_cited + facts_uncited on every document, and facts_cited_twice is the overlap where a fact is behind more than one link.",
          "type": "object",
          "required": ["facts", "facts_cited", "facts_uncited", "facts_cited_twice", "nodes", "links"],
          "additionalProperties": false,
          "properties": {
            "facts": { "type": "integer", "minimum": 0 },
            "facts_cited": { "type": "integer", "minimum": 0 },
            "facts_uncited": { "type": "integer", "minimum": 0 },
            "facts_cited_twice": { "type": "integer", "minimum": 0 },
            "nodes": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 }
          }
        },
        "caveats": {
          "type": "array",
          "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/caveat.schema.json" }
        }
      }
    },
    "nodes": {
      "description": "Empty is a document, not an error: a projection over facts that select nothing publishes an empty graph. What is refused is a null.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "label", "tier", "parent", "constraint_tier", "role",
          "derived", "rationale", "source_note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "tier": { "type": "integer", "minimum": 0 },
          "parent": { "type": "string" },
          "constraint_tier": { "type": "string" },
          "role": { "type": "string" },
          "derived": { "type": "boolean" },
          "rationale": { "type": "string" },
          "source_note": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source", "target", "value_cents", "kind", "transfer_id",
          "fact_ids", "locators", "derived", "partition", "contra"
        ],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "value_cents": {
            "description": "Integer cents as printed, signed: a contra row, printed in parentheses, arrives negative.",
            "type": "integer"
          },
          "kind": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/link_kind" },
          "transfer_id": { "type": "string" },
          "fact_ids": {
            "type": "array",
            "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json" }
          },
          "locators": {
            "type": "array",
            "items": { "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json" }
          },
          "derived": { "type": "boolean" },
          "partition": { "type": "boolean" },
          "contra": {
            "description": "The schedule this link is printed as a reduction of, in the words the page shows beside it. Empty on every link the document does not print negative.",
            "type": "string"
          }
        },
        "allOf": [
          {
            "description": "A published link cites at least one fact and names where it was read; a derived one cites nothing, because no page prints it.",
            "if": { "properties": { "derived": { "const": false } } },
            "then": {
              "properties": {
                "fact_ids": { "minItems": 1 },
                "locators": { "minItems": 1 }
              }
            }
          },
          {
            "description": "A negative figure names the schedule it reduces, and only a negative one does.",
            "if": { "properties": { "value_cents": { "exclusiveMaximum": 0 } }, "required": ["value_cents"] },
            "then": { "properties": { "contra": { "minLength": 1 } } },
            "else": { "properties": { "contra": { "const": "" } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "description": "A document that draws something says where it read it. An empty projection may cite nothing; one with nodes and no sources may not.",
      "if": { "properties": { "nodes": { "minItems": 1 } }, "required": ["nodes"] },
      "then": { "properties": { "metadata": { "properties": { "sources": { "minItems": 1 } } } } }
    },
    {
      "description": "THE HEADLINE IS THE SPINE'S ALONE: its keys are citywide totals and mean nothing on a schedule drawn over part of the city.",
      "if": { "properties": { "projection": { "const": "sankey" } }, "required": ["projection"] },
      "then": { "properties": { "metadata": { "required": ["headline"] } } },
      "else": { "properties": { "metadata": { "not": { "required": ["headline"] } } } }
    }
  ]
}
