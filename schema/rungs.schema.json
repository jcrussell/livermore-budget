{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcrussell.github.io/livermore-budget/schema/rungs.schema.json",
  "title": "fisc rung answer",
  "description": "Go's reading of a page's declared drill steps against the documents they draw: for every opened path, which nodes each column of the resulting chart holds, and which marks the client adds that no page prints.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "columns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "description": "The export that wrote this answer. The page carries the same string as exported_by, and the client refuses a pair that disagree, since nothing cache-busts one file against the other.",
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stem",
          "rungs"
        ],
        "additionalProperties": false,
        "properties": {
          "stem": {
            "type": "string",
            "minLength": 1
          },
          "rungs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "step",
                "draws"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "draws": {
                  "description": "One entry per column of the chart this rung draws, left to right. The ids are unfolded and uncapped: which of them a viewport leaves room for is the client's.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "tier",
                      "role",
                      "ids"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "tier": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "role": {
                        "enum": [
                          "centre",
                          "flank",
                          "outward"
                        ]
                      },
                      "ids": {
                        "description": "Written even when empty, so a column the document draws nothing at is distinct from one not answered.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "carried": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "needs": {
                        "description": "For each id of this column whose every ribbon leads into a widened column, the widened tier it is drawn with; a viewport dropping that column draws the id nowhere.",
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                },
                "amounts": {
                  "description": "The figure a mark prints, for the nodes on this rung whose drawn ribbons do not add up to it, such as a node a schedule prints a reduction under. A node with no entry is sized by the layout.",
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "marks": {
                  "description": "The marks the client draws on this rung that no page prints: the gap between what the chart above sends into the opened node and what the drawn document breaks it into, and the residual standing beside the opened node's parts.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "role",
                      "tier",
                      "label",
                      "rationale",
                      "source_note"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "enum": [
                          "residual",
                          "gap"
                        ]
                      },
                      "tier": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "in_cents": {
                        "type": "integer"
                      },
                      "out_cents": {
                        "type": "integer"
                      },
                      "label": {
                        "description": "What the mark is called on the chart. A residual is named for the grain its step's document does not split that money by; a gap is named for the disagreement it stands for.",
                        "type": "string",
                        "minLength": 1
                      },
                      "rationale": {
                        "description": "Why the mark exists, in the words the step declares; composed here, not in the client.",
                        "type": "string",
                        "minLength": 1
                      },
                      "source_note": {
                        "description": "What the mark's figure is and is not. Empty on a residual, whose note renders the citations of the flows it carries and is the client's; stated on a gap, whose figure is a difference no page prints.",
                        "type": "string"
                      },
                      "ends": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "locators": {
                        "description": "A gap's citations: every page a ribbon touching the opened node was read from, in the chart above's document and in the drawn one -- the pages of the two totals its rationale subtracts.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json"
                        }
                      }
                    },
                    "allOf": [
                      {
                        "description": "A gap states what its figure is, on exactly one side and positive, and cites the pages of both totals; it names no endpoint.",
                        "if": {
                          "properties": {
                            "role": {
                              "const": "gap"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "locators"
                          ],
                          "properties": {
                            "source_note": {
                              "minLength": 1
                            },
                            "in_cents": {
                              "minimum": 1
                            },
                            "out_cents": {
                              "minimum": 1
                            }
                          },
                          "oneOf": [
                            {
                              "required": [
                                "in_cents"
                              ]
                            },
                            {
                              "required": [
                                "out_cents"
                              ]
                            }
                          ],
                          "not": {
                            "required": [
                              "ends"
                            ]
                          }
                        }
                      },
                      {
                        "description": "A residual names the endpoints whose flow it carries, carries a positive figure on at least one side, and cites through its endpoints rather than through locators or a note of its own.",
                        "if": {
                          "properties": {
                            "role": {
                              "const": "residual"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "ends"
                          ],
                          "properties": {
                            "source_note": {
                              "maxLength": 0
                            },
                            "in_cents": {
                              "minimum": 1
                            },
                            "out_cents": {
                              "minimum": 1
                            }
                          },
                          "anyOf": [
                            {
                              "required": [
                                "in_cents"
                              ]
                            },
                            {
                              "required": [
                                "out_cents"
                              ]
                            }
                          ],
                          "not": {
                            "required": [
                              "locators"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
