{
  "$comment": "The DOM each client module binds, per page fisc export writes. Go holds every page it writes to its entry (and every page to chrome); the client tests hold each skeleton under testdata/client/ to the same entry and boot the module over it. A selector is compound parts (tag, #id, .class, [attr], [attr=\"value\"]) joined by a space or ' > '; one beginning template#<id> matches inside that template's content.",
  "chrome": {
    "$comment": "theme.js, on every page fisc export writes.",
    "selectors": [
      "nav.site-nav button#theme-toggle[hidden]",
      "template#lede-more > button.lede-more"
    ]
  },
  "pages": {
    "flows.html": {
      "skeleton": "testdata/client/flows.html",
      "modules": ["app.js", "theme.js"],
      "selectors": [
        "nav.site-nav button#nav-toggle[aria-controls=\"nav-views\"]",
        "nav.site-nav ul#nav-views span[aria-current=\"page\"]",
        "nav.site-nav a[data-years]",
        "select#year-select",
        "main",
        "#chart-card > div.chart-body#chart-body",
        "#chart-toolbar #search[hidden]",
        "#search input#search-input[aria-controls=\"search-list\"]",
        "#search ul#search-list[role=\"listbox\"]",
        "#search #search-status",
        "#chart-tools button#chart-expand-all",
        "#chart-tools button#chart-collapse-all",
        "#chart-tools button#chart-zoom-reset",
        "#chart-tools button#chart-fullscreen",
        "p#filter-line[hidden] span#filter-said",
        "#filter-line button#filter-reset",
        "#chart-body div#rail button#rail-toggle[aria-controls=\"rail-content\"]",
        "#rail div#rail-content",
        "#rail-content #legend-head",
        "#rail-content div.legend#legend",
        "#rail-content details#filters[hidden]",
        "#filters button#filter-all[aria-label]",
        "#filters button#filter-none[aria-label]",
        "#filters label[for=\"filter-smallest\"]",
        "#filters div#filter-group-list",
        "#filters div#filter-kind-list",
        "#filters input#filter-smallest[type=\"range\"]",
        "#filters output#filter-smallest-value",
        ".chart-scroll > svg.sankey#chart",
        "svg#chart title#chart-title",
        "svg#chart desc#chart-desc",
        "p#splits-line[hidden]",
        "p#hairline-line[hidden]",
        "div.tooltip#tooltip",
        "#chart-body aside#drawer",
        "#drawer button#detail-follow",
        "#drawer button#detail-pin",
        "#drawer button#detail-menu",
        "#drawer div#detail",
        "#drawer #chart-hint",
        "button#narrow-show",
        "p.lede span#hero",
        "p.lede span#lede-year",
        "span#counts-line"
      ]
    },
    "department.html": {
      "skeleton": "testdata/client/department.html",
      "modules": ["department.js", "theme.js"],
      "selectors": [
        "script#department-config[type=\"application/json\"]",
        "header.page-head .lede",
        "select#year-select",
        "details.how-to-read",
        "main#department-main",
        "#department-main h2#bars-heading",
        "ul#department-legend",
        "ol#department-list",
        "h3#department-heading",
        "p#department-tie[data-ties][data-held]",
        "section.department-side[data-side=\"funding\"] p.sides-total",
        "section.department-side[data-side=\"funding\"] figure.sides-figure",
        "section.department-side[data-side=\"spending\"] p.sides-total",
        "section.department-side[data-side=\"spending\"] figure.sides-figure",
        "section.department-side[data-side=\"spending\"] p#transfers-says",
        "div.tooltip#tooltip",
        "template#department-bar > li.department-bar",
        "template#department-bar .department-row[role=\"button\"]",
        "template#department-bar .department-name",
        "template#department-bar .department-track",
        "template#department-bar .department-value",
        "template#department-bar .department-detail ul.department-groups",
        "template#department-bar a.department-to-sides",
        "template#department-seg > span.department-seg",
        "template#department-key > li .department-key-name",
        "template#department-group > li .department-group-name",
        "template#department-group .department-group-value",
        "template#department-group .department-group-share",
        "template#ledger-list > ol.ledger-list",
        "template#ledger-row > li.bar-row .bar-label",
        "template#ledger-row .bar-track .bar-fill",
        "template#ledger-row .bar-value",
        "template#ledger-row .bar-share"
      ]
    },
    "ledger.html": {
      "skeleton": "testdata/client/ledger.html",
      "modules": ["ledger.js", "sides.js", "theme.js"],
      "selectors": [
        "script#sides-config[type=\"application/json\"]",
        "header.page-head .lede span#lede-year",
        "select#year-select",
        "details.how-to-read",
        "main#sides-main",
        "section.sides-side[data-tier] p.sides-total",
        "section.sides-side[data-tier] figure.sides-figure",
        "div.tooltip#tooltip",
        "template#ledger-list > ol.ledger-list",
        "template#ledger-row > li.bar-row .bar-label",
        "template#ledger-row .bar-track .bar-fill",
        "template#ledger-row .bar-value",
        "template#ledger-row .bar-share"
      ]
    }
  }
}
