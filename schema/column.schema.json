{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcrussell.github.io/livermore-budget/schema/column.schema.json",
  "title": "fisc published column",
  "description": "Everything the chart needs for one published column of the city's budget, keyed by (fiscal_year, basis) rather than by year.",
  "type": "object",
  "required": [
    "schema_version",
    "column",
    "nodes",
    "fund_groups",
    "schedules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "column": {
      "type": "object",
      "required": [
        "fiscal_year",
        "basis",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1900
        },
        "basis": {
          "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/basis"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "description": "One table shared by every schedule: a node's identity and its own annotations, each stated once. Where it hangs belongs to the schedule that draws it.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tier"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "description": "What this node is for, so a client never parses its id. The declared set, not the observed one.",
            "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/role"
          },
          "derived": {
            "type": "boolean"
          },
          "constraint_tier": {
            "description": "A fund's tier as data/funds.yaml reads it, our reading of pp.258-261; empty where the document classifies nothing.",
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "source_note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "description": "A derived node says why it exists and what it was read from; a tier is read from a note and carries it.",
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "derived": {
                      "const": true
                    }
                  },
                  "required": [
                    "derived"
                  ]
                },
                {
                  "properties": {
                    "constraint_tier": {
                      "minLength": 1
                    }
                  },
                  "required": [
                    "constraint_tier"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "rationale",
                "source_note"
              ],
              "properties": {
                "rationale": {
                  "minLength": 1
                },
                "source_note": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "fund_groups": {
      "description": "The fund groups this column draws, in the order the page lays the fund column out. Ordered, not closed: data/funds.yaml can add a fund type.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slot"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The fund-group node's id, as it appears in the nodes table.",
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "description": "The 1-based categorical slot the group wears, which site/style.css binds a hue to as --fund-slot-<n>; 0 for a group with none, drawn muted. Shipped so the client never parses the id.",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "schedules": {
      "description": "ONE ENTRY PER PRINTED SCHEDULE, NOT MERGED: each keeps its own provenance, and cells two schedules print differently stay unreconciled.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "scopes",
          "sources",
          "nodes",
          "links"
        ],
        "additionalProperties": false,
        "properties": {
          "counts": {
            "type": "object",
            "required": [
              "facts",
              "nodes",
              "links"
            ],
            "properties": {
              "facts": {
                "type": "integer",
                "minimum": 0
              },
              "facts_cited": {
                "type": "integer",
                "minimum": 0
              },
              "nodes": {
                "type": "integer",
                "minimum": 0
              },
              "links": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "$ref": "https://jcrussell.github.io/livermore-budget/schema/caveat.schema.json"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "value_cents",
                "kind",
                "fact_ids",
                "locators"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "description": "An index into the nodes table.",
                  "type": "integer",
                  "minimum": 0
                },
                "to": {
                  "description": "An index into the nodes table.",
                  "type": "integer",
                  "minimum": 0
                },
                "value_cents": {
                  "description": "Integer cents, as the document printed it. A contra row arrives already negative.",
                  "type": "integer"
                },
                "kind": {
                  "$ref": "https://jcrussell.github.io/livermore-budget/schema/enums.schema.json#/$defs/link_kind"
                },
                "transfer_id": {
                  "type": "string"
                },
                "fact_ids": {
                  "description": "The facts this figure IS. Empty only on a derived link, which cites nothing because no page prints it.",
                  "type": "array",
                  "items": {
                    "$ref": "https://jcrussell.github.io/livermore-budget/schema/fact-id.schema.json"
                  }
                },
                "locators": {
                  "type": "array",
                  "items": {
                    "$ref": "https://jcrussell.github.io/livermore-budget/schema/locator.schema.json"
                  }
                },
                "derived": {
                  "type": "boolean"
                },
                "partition": {
                  "description": "The ribbon divides one printed table along a second axis rather than following money the schedule prints as moving that way.",
                  "type": "boolean"
                },
                "contra": {
                  "description": "The schedule this link is printed as a reduction of, in the words the page shows beside it. Present only on a link the document prints negative.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "description": "A published link cites at least one fact and names where it was read; a derived one cites nothing.",
                  "if": {
                    "anyOf": [
                      {
                        "properties": {
                          "derived": {
                            "const": false
                          }
                        }
                      },
                      {
                        "not": {
                          "required": [
                            "derived"
                          ]
                        }
                      }
                    ]
                  },
                  "then": {
                    "properties": {
                      "fact_ids": {
                        "minItems": 1
                      },
                      "locators": {
                        "minItems": 1
                      }
                    }
                  }
                },
                {
                  "description": "A negative figure names the schedule it reduces, and only a negative one does.",
                  "if": {
                    "properties": {
                      "value_cents": {
                        "exclusiveMaximum": 0
                      }
                    },
                    "required": [
                      "value_cents"
                    ]
                  },
                  "then": {
                    "required": [
                      "contra"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "contra"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "nodes": {
            "description": "The nodes this schedule draws, each by its index into the column's node table, with the one thing a schedule states for itself: where the node hangs in its hierarchy. The same mark may hang elsewhere, or nowhere, in another schedule of the same column.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "node"
              ],
              "additionalProperties": false,
              "properties": {
                "node": {
                  "description": "An index into the column's node table.",
                  "type": "integer",
                  "minimum": 0
                },
                "parent": {
                  "type": "string"
                }
              }
            }
          },
          "scopes": {
            "description": "The fact-store scopes this schedule draws; fund-flows spans two.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
