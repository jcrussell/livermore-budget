{{- /* The parts every page shares above its own content. renderPage parses
       this file before the page.

       "theme-stamp" goes in the head. Inline and tiny on purpose: it stamps
       the saved theme before first paint, which a deferred script cannot do
       without painting the page in the wrong mode first.

       "topbar" goes at the top of the body, executed against the page's own
       data, of which it reads .Nav and .YearSelect. The view list is drawn
       only when there is more than one view; a link to a view that draws one
       year at a time lists that view's years in data-years. The theme toggle
       is on every page, at the end of the nav's one row. The toggle SHIPS
       HIDDEN, because with JavaScript off it would switch nothing:
       site/theme.js shows it as it wires it, booted by the module script
       beside it.

       On a narrow screen the view list folds behind a menu button naming
       the page you are on. The button SHIPS HIDDEN too, so with JavaScript
       off the list is shown whole and wraps; theme.js wireMenu shows the
       button and folds the list (the fold itself is style.css's, under its
       narrow-screen media query).

       The "lede-more" template is the button theme.js wireLede puts under a
       page head's lede where a narrow screen's clamp cuts it.

       "year-select" is the page's one year control, drawn in a row of its
       own under the nav, in the same place on every page that offers more
       than one year. It SHIPS DISABLED for the same reason; the page's
       script enables it (format.js wireYearSelect). */ -}}
{{define "theme-stamp"}}<script>
  try {
    var t = localStorage.getItem("fisc-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) { /* private mode: fall back to the OS setting */ }
</script>{{end}}
{{define "topbar"}}<nav class="site-nav" aria-label="Views">
  {{- if gt (len .Nav) 1}}
  <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-views" hidden>Menu {{range .Nav}}{{if .Current}}<span class="nav-here">{{.Label}}</span>{{end}}{{end}}</button>
  <ul id="nav-views">
    {{- range .Nav}}
    <li>{{if .Current}}<span aria-current="page">{{.Label}}</span>{{else}}<a href="{{.Path}}"{{with .YearKeys}} data-years="{{.}}"{{end}}>{{.Label}}</a>{{end}}</li>
    {{- end}}
  </ul>
  {{- end}}
  <button type="button" id="theme-toggle" hidden>Dark mode</button>
</nav>
<template id="lede-more"><button type="button" class="lede-more">More</button></template>
{{- template "year-select" .YearSelect}}
<script type="module">import { boot } from "./theme.js"; boot(window);</script>{{end}}
{{define "year-select"}}
{{- if gt (len .Options) 1}}
<div class="year-bar">
  <label class="year-select">Budget year
    <select id="year-select" disabled>
      {{- range .Options}}
      <option value="{{.Key}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>
      {{- end}}
    </select>
  </label>
</div>
{{- end}}
{{- end}}
{{- /* "caveats-line" is a page's caveats in one line, executed against the
       page's .CaveatsHere: each theme of this page's section of the caveats
       page with how many of its caveats apply, linking to that theme's list
       there. With no caveats page (an empty .Href) it lists each caveat's
       summary instead, so a site without that page still states them. */}}
{{define "caveats-line"}}
{{- if .Href}}
{{- if .Groups}}
<p class="caveats-line">Limits on these figures:
  {{- range $i, $g := .Groups}}{{if $i}} ·{{end}} <a href="{{$.Href}}#{{$g.Anchor}}">{{$g.Heading}} ({{len $g.Entries}})</a>{{end}}</p>
{{- end}}
{{- else if .Entries}}
<ul class="caveats" aria-label="What these figures do not say">
  {{- range .Entries}}
  <li>{{.Summary}}</li>
  {{- end}}
</ul>
{{- end}}
{{- end}}
{{- /* "footer" closes every page, executed against the page's own data. With
       a sources page (.SourcesPath) it links there, but not from that page
       itself (.SourcesPage), and every page this view cites is listed on it;
       with none, it folds the "sources" list in its
       place, so a cited page is always listed somewhere. */}}
{{define "footer"}}<footer>
  {{- if and .Sources (not .SourcesPath)}}
  {{template "sources" .}}
  {{- end}}
  <p>Built from the City of Livermore's published budget PDFs
    {{- if and .SourcesPath (not .SourcesPage)}} · <a href="{{.SourcesPath}}">Sources and data</a>{{end}}
    · <a href="{{.Repository}}">Code on GitHub</a></p>
</footer>{{end}}
