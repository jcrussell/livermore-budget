{{- /* The parts every page shares above its own content. renderPage parses
       this file before the page.

       "theme-stamp" goes in the head. Inline and tiny on purpose: it stamps
       the saved theme before first paint, which a deferred script cannot do
       without painting the page in the wrong mode first.

       "topbar" goes at the top of the body, executed against the page's own
       data, of which it reads .Nav and nothing else. The view list is drawn
       only when there is more than one view; the theme toggle is on every
       page. The toggle SHIPS HIDDEN, because with JavaScript off it would
       switch nothing: site/theme.js shows it as it wires it, booted by the
       module script beside it. */ -}}
{{define "theme-stamp"}}<script>
  try {
    var t = localStorage.getItem("fisc-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) { /* private mode: fall back to the OS setting */ }
</script>{{end}}
{{define "topbar"}}<nav class="site-nav" aria-label="Views">
  {{- if gt (len .Nav) 1}}
  <ul>
    {{- range .Nav}}
    <li>{{if .Current}}<span aria-current="page">{{.Label}}</span>{{else}}<a href="{{.Path}}">{{.Label}}</a>{{end}}</li>
    {{- end}}
  </ul>
  {{- end}}
  <button type="button" id="theme-toggle" hidden>Dark mode</button>
</nav>
<script type="module">import { boot } from "./theme.js"; boot(window);</script>{{end}}
{{- /* "caveats-line" is a page's caveats in one line, executed against the
       page's .CaveatsHere: how many apply, linking to this page's section of
       the caveats page. With no caveats page (an empty .Href) it lists each
       caveat's summary instead, so a site without that page still states
       them. */}}
{{define "caveats-line"}}
{{- if .Count}}
{{- if .Href}}
<p class="caveats-line"><a href="{{.Href}}">{{.Count}} caveat{{if eq .Count 1}} applies{{else}}s apply{{end}} to this page &rarr;</a></p>
{{- else}}
<ul class="caveats" aria-label="What these figures do not say">
  {{- range .Refs}}
  <li>{{.Summary}}</li>
  {{- end}}
</ul>
{{- end}}
{{- end}}
{{- end}}
