{{- /* The cited-page list the "footer" template folds on a site with no
       sources page. It reads .Sources and .Projections and nothing else.
       renderPage parses this file before the page, so a page that defines
       "sources-heading" names its own list; one that does not reads
       "Sources". */ -}}
{{define "sources"}}<details class="apparatus" id="sources-view">
    <summary>
      <h3>{{block "sources-heading" .}}Sources{{end}}</h3>
      <span class="apparatus-hint">{{len .Sources}} document{{if ne (len .Sources) 1}}s{{end}},
        every page this view cites, and {{len .Projections}} data file{{if ne (len .Projections) 1}}s{{end}}</span>
    </summary>
    <ul>
      {{- range .Sources}}
      <li>
        {{if .PDFURL}}<a href="{{.PDFURL}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .Publisher}}, {{.Publisher}}{{end}}
        {{- if .Pages}} —
        {{- range $i, $p := .Pages}}{{if $i}}, {{end}}
          <a href="{{$p.PDFURL}}">p{{$p.Number}} (PDF)</a> /
          <a href="{{$p.TextURL}}">extracted text</a>
        {{- end}}{{end}}
      </li>
      {{- end}}
    </ul>
    <p class="subtle">
      {{- /* THE FILE LIST FOLDS WITH THE SOURCE LIST because it is the same
             kind of thing: a set of links that grows with the corpus, useful
             to a reader who came for the data and furniture to one who did
             not. What stays outside is the sentence naming the scope, the
             basis and the file THIS page is drawn from. */}}
      Every data file the site publishes, each fetchable on its own:
      {{- range $i, $p := .Projections}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Path}}</a>{{end}}.
    </p>
  </details>{{end}}
