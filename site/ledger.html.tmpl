<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
<script type="application/json" id="sides-config">{{.ConfigJSON}}</script>
<!-- A module is deferred, so it runs once the sections below are parsed;
     importing ledger.js runs nothing, so boot() is called here. -->
<script type="module">import { boot } from "./ledger.js"; boot(window);</script>
</head>
<body>

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">
      {{.Lede}} Drawn from the <span id="lede-year">{{.OpensLede}}</span> budget.
    </p>
  </div>
</header>

<main id="sides-main">

<p class="sides-how">
  Each side is a list of bars, largest first, every bar on the one scale the page's largest bar sets. Click a bar that opens to see its parts under it, indented; click it again to close it. Shift-click opens a bar its other way where the budget prints one. A bar marked <em>inferred</em> is a figure the city prints only
  as a difference; one with a leading minus is printed as a reduction and
  counts against its parent. Every figure is a sum of cells the city printed,
  and pointing at a bar, or focusing it, names the pages it was read from. A share
  marked ◇ is ours: one bar as a percentage of its side.
</p>

<ul class="sides-key" aria-label="Key">
  <li><span class="key-swatch can-open" aria-hidden="true"></span> opens with a click</li>
  <li><span class="key-swatch opened" aria-hidden="true"></span> opened; a click closes it</li>
  <li><span class="key-swatch reduction" aria-hidden="true"></span> printed as a reduction, drawn at its size</li>
  <li><span class="key-swatch derived" aria-hidden="true"></span> inferred: printed only as a difference</li>
</ul>

<div class="sides">
{{- range .Sides}}
<section class="sides-side" data-tier="{{.Tier}}" aria-labelledby="side-{{.Tier}}">
  <h2 id="side-{{.Tier}}">{{.Heading}}</h2>
  <p class="sides-total subtle"></p>
  {{- /* Hidden until the script fills it from the templates at the foot of
         main; with no script the page says so. */}}
  <figure class="sides-figure" hidden></figure>
</section>
{{- end}}
</div>

<noscript><p class="refusal">This page draws its bars in the browser; with scripts off it shows none. <a href="index.html">The glance page</a> needs none: it lists, for each year, the printed cells behind where the money comes from, what it buys and which department spends it.</p></noscript>

<div class="tooltip" id="tooltip" role="status" aria-live="polite" hidden></div>

{{- template "caveats-line" .CaveatsHere}}

<!-- What the script clones per drawn piece, so the figure's markup lives
     here and the script fills figures in. -->
<template id="ledger-list"><ol class="ledger-list"></ol></template>
<template id="ledger-row"><li class="bar-row" tabindex="0" role="button"><span class="bar-label"></span><span class="bar-track"><span class="bar-fill"></span></span><span class="bar-value"></span><span class="bar-share subtle"></span></li></template>
</main>

{{template "footer" .}}

</body>
</html>
