<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="Every revenue line the City of Livermore prints per fund, across four budget columns, each figure linked to the page it was read from.">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
<script>
  // Stamp the saved theme before first paint, the same way index.html does, so
  // a reader who chose dark there does not get a white flash here. This page
  // ships no app.js, so this is the whole of its scripting: the theme BUTTON is
  // deliberately absent rather than present and dead.
  try {
    var t = localStorage.getItem("fisc-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) { /* private mode: fall back to the OS setting */ }
</script>
</head>
<body>

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{- if gt (len .Nav) 1}}
<nav class="site-nav" aria-label="Views">
  <ul>
    {{- range .Nav}}
    <li>{{if .Current}}<span aria-current="page">{{.Label}}</span>{{else}}<a href="{{.Path}}">{{.Label}}</a>{{end}}</li>
    {{- end}}
  </ul>
</nav>
{{- end}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<p class="lede">
  {{.Count}} printed rows across {{len .Columns}} columns, {{.Facts}} figures in all. Every
  one is a number the city printed; each links to the extracted text of the page it was read
  from. Nothing here is a total, a growth rate or a share — this page publishes what the
  document publishes and computes nothing of its own.
</p>

<!-- The scale limit is stated where a reader meets it, not in a caveat further
     down. A mark that is comparable across rows is the thing a reader will
     assume unless told, and these rows span three orders of magnitude. -->
<p class="lede subtle">
  The <strong>Shape</strong> column draws each row's own {{len .Columns}} figures at that
  row's own scale, so the tallest bar in every row is the figure furthest from zero —
  <em>marks in different rows are not comparable with each other</em>. A
  <strong>dot</strong> on the line is a zero the city printed; an empty slot is a column
  this row does not appear in, which is not the same thing — and the smallest bar is a real
  figure too small to draw at this scale, never a zero. The rules inside a mark fall where the rules
  between the column headers do: a measurement changes there, and a comparison should not
  be carried across one.
</p>

{{- if .Caveats}}
<section class="caveats" aria-label="Caveats">
  <h2>What this table does not say</h2>
  <ul>
    {{- range .Caveats}}
    <li>{{if .Href}}<a href="{{.Href}}">{{.Summary}}</a>{{else}}{{.Summary}}{{end}}</li>
    {{- end}}
  </ul>
</section>
{{- end}}

<!-- The columns are four different MEASUREMENTS and the table says so in the
     markup, not only in prose: each header carries its basis and its
     comparable_group, and the first column of each new group takes a rule.
     A reader comparing across one of those rules is comparing money that moved
     with money somebody intends to spend. -->
<div class="table-scroll">
<table class="series-table">
  <caption>Revenue by fund and line, {{.Scope}}</caption>
  <thead>
    <tr>
      <th scope="col">Fund</th>
      <th scope="col">Line</th>
      <th scope="col">Category</th>
      <th scope="col" class="mark-head">Shape</th>
      {{- range .Columns}}
      <th scope="col" class="num{{if .New}} group-start{{end}}" data-comparable-group="{{.Group}}">
        {{.Label}}<span class="basis">{{.Basis}}</span>
      </th>
      {{- end}}
    </tr>
  </thead>
  <tbody>
    {{- range .Series}}
    <tr data-fund-group="{{.Group}}">
      <th scope="row">{{.Fund}}</th>
      <td>{{.Label}}</td>
      <td class="subtle">{{.Category}}</td>
      <td class="mark">
        {{- with .Mark}}
        <svg viewBox="0 0 {{.Width}} {{.Height}}" width="{{.Width}}" height="{{.Height}}"
             role="img" aria-label="{{.Label}}" preserveAspectRatio="xMidYMid meet">
          <line class="mark-base" x1="0" y1="{{.Baseline}}" x2="{{.Width}}" y2="{{.Baseline}}"/>
          {{- $h := .Height}}
          {{- range .Rules}}
          <line class="mark-rule" x1="{{.}}" y1="0" x2="{{.}}" y2="{{$h}}"/>
          {{- end}}
          {{- range .Bars}}
          {{- if .Zero}}
          <circle cx="{{.CX}}" cy="{{.Y}}" r="{{.R}}" class="mark-zero"
          ><title>{{.Title}}</title></circle>
          {{- else}}
          <rect x="{{.X}}" y="{{.Y}}" width="{{.Width}}" height="{{.Height}}"
                class="mark-bar{{if .Negative}} contra{{end}}"
          ><title>{{.Title}}</title></rect>
          {{- end}}
          {{- end}}
        </svg>
        {{- end}}
      </td>
      {{- range .Cells}}
      <td class="num{{if .New}} group-start{{end}}{{if .Negative}} contra{{end}}{{if .Missing}} missing{{end}}">
        {{- if .Missing}}
        <span title="This row is not printed in this column">{{.Value}}</span>
        {{- else}}
        <a href="{{.Href}}" title="Read on page {{.Page}}">{{.Value}}</a>
        {{- end}}
      </td>
      {{- end}}
    </tr>
    {{- end}}
  </tbody>
</table>
</div>

</main>

<footer>
  <h3>Sources</h3>
  <ul>
    {{- range .Sources}}
    <li>
      {{if .PDFURL}}<a href="{{.PDFURL}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}{{if .Publisher}}, {{.Publisher}}{{end}}
      {{- if .Pages}} —
      {{- range $i, $p := .Pages}}{{if $i}}, {{end}}
        <a href="{{$p.PDFURL}}">p{{$p.Number}} (PDF)</a> /
        <a href="{{$p.TextURL}}">extracted text</a>
      {{- end}}{{end}}
    </li>
    {{- end}}
  </ul>
  <p class="subtle">
    Scope {{.Scope}}. Projection: {{.ProjectionBy}}. Packaged by {{.ExportedBy}}.
    This table is drawn from <a href="{{.DataPath}}">{{.DataPath}}</a>.
    Every data file the site publishes, each fetchable on its own:
    {{- range $i, $p := .Projections}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Path}}</a>{{end}}.
  </p>
</footer>

</body>
</html>
