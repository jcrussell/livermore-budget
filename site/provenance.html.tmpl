{{define "description"}}Every figure this site publishes, as records you can download, indexed by the page of the city's own document it was read from.{{end -}}
{{define "body-class"}} class="prose-page"{{end -}}
{{template "head" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<p class="lede">
  {{.Records}} figures across {{.Pages}} pages of {{.Documents}} document{{if ne .Documents 1}}s{{end}}. Every one carries
  the document, page and byte offset it was read from, and the text it was parsed from,
  kept verbatim. Nothing on this page is computed: it is an index of what the site
  publishes, not a summary of it.
</p>

<!-- The addressing rule is stated where a reader meets it. It is the promise
     that makes these links worth citing: a rebuilt store moves fact ids, and
     does not move a page. -->
<p class="lede subtle">
  A citation here is a <strong>locator</strong> — document, page, byte offset — and never a
  fact id. The records for any page are at <code>facts/&lt;document&gt;/pages/pNNNN.jsonl</code>,
  a path you can compose yourself from the locator alone, with no lookup. Fact ids are
  content-addressed over the rule that produced them, so revising a rule moves every id on a
  page; the page cannot move. Amounts are <strong>integer cents</strong> throughout —
  divide by 100 for dollars.
</p>

<h2>Download</h2>
<p class="subtle">Open a file to read what it holds, then download it.</p>
<div class="files">
  {{- range .Downloads}}
  <details class="file">
    <summary>{{.Label}} <span class="subtle">— {{.Path}}</span></summary>
    {{- if .Note}}
    <p>{{.Note}}</p>
    {{- end}}
    <p><a class="download" href="{{.Path}}" download>Download {{.Path}}</a> <span class="subtle">{{.Bytes}} bytes</span></p>
  </details>
  {{- end}}
</div>
<h3>The data files</h3>
<p>Every data file the site's pages are drawn from, each fetchable on its own:</p>
<div class="files" id="data-files">
  {{- range .DataFiles}}
  <details class="file">
    <summary>{{.Path}} <span class="subtle">—
      {{- if .Label}} {{.Label}}{{else if .Pages}} for{{range $i, $p := .Pages}}{{if $i}},{{end}} {{$p.Label}}{{end}}{{else}} drawn by no page{{end}}</span></summary>
    <p>
      {{- if .Pages}}
      Drawn on
      {{- range $i, $p := .Pages}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}.
      {{- else}}
      No page draws it; it is published for whoever fetches it.
      {{- end}}
    </p>
    {{- if .Sources}}
    <p>Read from
      {{- range $i, $s := .Sources}}{{if $i}};{{end}}
      {{if $s.PDFURL}}<a href="{{$s.PDFURL}}">{{$s.Title}}</a>{{else}}{{$s.Title}}{{end}},
      {{len $s.Pages}} page{{if ne (len $s.Pages) 1}}s{{end}}
      {{- end}}.
    </p>
    {{- end}}
    {{- if .Caveats}}
    <p>Carries {{.Caveats}} caveat{{if ne .Caveats 1}}s{{end}}
      {{- if .CaveatsPath}}; each is stated in full on <a href="{{.CaveatsPath}}">the caveats page</a>{{end}}.</p>
    {{- end}}
    <p><a class="download" href="{{.Path}}" download>Download {{.Path}}</a></p>
  </details>
  {{- end}}
</div>
<p class="subtle">Packaged by {{.ExportedBy}}.</p>

{{- /* Every column's derived nodes with their rationale and source note:
       the one place the site states what is ours rather than the city's. */}}
<h2 id="inferred">What we inferred</h2>
<p class="lede subtle">Each entry marked ◇ is ours, not a line the city printed, and says why.</p>
{{- range .Inferred}}
<section class="inferred-column" data-column="{{.Path}}">
  <h3>{{.Label}} <span class="subtle">(<a href="{{.Path}}">{{.Path}}</a>)</span></h3>
  <ul class="derived-list">
    {{- range .Nodes}}
    <li><div class="what">◇ {{.Label}}</div>{{if .Rationale}}<div class="why">{{.Rationale}}</div>{{end}}{{if .SourceNote}}<div class="subtle">{{.SourceNote}}</div>{{end}}
      {{- if .Flows}}
      <ul class="inferred-flows">
        {{- range .Flows}}
        <li data-facts="{{.Facts}}">{{template "inferred-flow" .}}</li>
        {{- end}}
      </ul>
      {{- end}}
    </li>
    {{- end}}
    {{- range .Flows}}
    <li data-facts="{{.Facts}}"><div class="what">{{template "inferred-flow" .}}</div><div class="why">{{$.Wording.FlowInferred}}</div></li>
    {{- end}}
    {{- if and (not .Nodes) (not .Flows)}}
    <li class="subtle">Nothing in this column is inferred: every node and flow is printed by the city.</li>
    {{- end}}
  </ul>
</section>
{{- end}}

{{- /* THE PAGE TABLE FOLDS WHOLE: it is an index a reader opens to find one
       page. Each download folds on its own, under a summary naming it, so
       the file list stays in view; the locator paragraph above is what makes
       every link in the table citable. */}}
<details class="apparatus" id="pages-view">
  <summary>
    <h2>By page</h2>
    <span class="apparatus-hint">{{len .Rows}} page{{if ne (len .Rows) 1}}s{{end}}, each linked
      to its extracted text and its records</span>
  </summary>
<div class="table-scroll">
<table>
  <thead>
    <tr>
      <th scope="col">Page</th>
      <th scope="col" class="num">Figures</th>
      <th scope="col">What is on it</th>
      <th scope="col">Read it</th>
    </tr>
  </thead>
  <tbody>
    {{- range .Rows}}
    <tr>
      <th scope="row">{{.DocTitle}} p{{.Page}}</th>
      <td class="num">{{.Records}}</td>
      <td>{{.Note}}</td>
      <td>
        {{- if .PDFURL}}<a href="{{.PDFURL}}">PDF</a> / {{end}}
        <a href="{{.TextURL}}">extracted text</a> /
        <a href="{{.DataURL}}">{{.Records}} records</a>
        <span class="subtle">({{.Bytes}} bytes)</span>
      </td>
    </tr>
    {{- end}}
  </tbody>
</table>
</div>
</details>

</main>

{{template "footer" .}}

</body>
</html>
{{- /* "inferred-flow" is one derived flow: its ends, the cents its link
       carries and the pages that link cites, each to its text and its PDF. */}}
{{define "inferred-flow"}}◇ {{.From}} → {{.To}}: {{.Dollars}} <span class="subtle">(
  {{- range $i, $p := .Pages}}{{if $i}}, {{end}}<a href="{{$p.TextURL}}">p{{$p.Number}}</a>{{if $p.PDFURL}} <a href="{{$p.PDFURL}}">PDF</a>{{end}}{{end -}}
  )</span>{{end}}
