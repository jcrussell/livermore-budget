<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="The headline totals of the City of Livermore's budget, each year's, with the column total that counts transfers twice.">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
</head>
<body>

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    {{- if .Lede}}
    <p class="lede">{{.Lede}}</p>
    {{- end}}
  </div>
</header>

<main>
{{- range .Years}}
<section class="totals-year">
  <h2>{{.Label}}</h2>
  <div class="figures">
    {{- range .Figures}}
    {{- /* Each kind spelled out, so the stylesheet's .hero and .error are
           visibly worn (site/render.test.mjs). */}}
    <div class="tile{{if eq .Kind `hero`}} hero{{end}}{{if eq .Kind `error`}} error{{end}}">
      <div class="label">{{.Label}}</div>
      <div class="value">{{.Value}}</div>
      <div class="note">{{.Note}}</div>
    </div>
    {{- end}}
  </div>
  {{- if .Caveats}}
  <ul class="caveats">
    {{- range .Caveats}}
    <li>{{if .Href}}<a href="{{.Href}}">{{.Summary}}</a>{{else}}{{.Summary}}{{end}}</li>
    {{- end}}
  </ul>
  {{- end}}
</section>
{{- end}}
</main>

<footer>
  {{template "sources" .}}
  <p class="subtle">
    Scope {{.Scope}}. Projection: {{.ProjectionBy}}. Packaged by {{.ExportedBy}}.
  </p>
</footer>

</body>
</html>
