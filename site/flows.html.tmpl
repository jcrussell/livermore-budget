{{define "description"}}Every figure on this page is traced to a page of the City of Livermore's published budget, and what we inferred is marked as inferred.{{end -}}
{{template "head" .}}

{{- /* ABOVE THE CHART ONLY WHAT OPERATES IT: the title, and in the card the
       toolbar and the filter line; the year is the year bar's, under the nav. The lede, the hairline and
       splits sentences and the description follow the chart, so the opening
       chart fits the window it is laid out to (app.js roomHeight). */}}
<header class="page-head chart-head">
  <h1>Where Livermore's money comes from, and where it goes</h1>
</header>

<main>

{{- /* The card is what full screen shows: toolbar, rail, chart and drawer. */}}
<div class="card" id="chart-card" role="region" aria-label="The flow">
  {{- /* ONE ROW ABOVE THE CHART: search and the view's own buttons. The year
         stays in the year bar under the nav: it swaps every figure on the
         page, not only the chart. */}}
  <div class="chart-toolbar" id="chart-toolbar">
    {{- /* SHIPPED HIDDEN AND EMPTY, as the filters are: what the chart draws
           is the client's, so app.js unhides the box and lists the marks. A
           combobox over a listbox, the ARIA 1.2 pattern. */}}
    <div class="search" id="search" hidden>
      <label for="search-input" id="search-label">{{.Wording.SearchLabel}}</label>
      <input type="text" id="search-input" role="combobox" aria-autocomplete="list"
             aria-expanded="false" aria-controls="search-list" autocomplete="off" spellcheck="false">
      <ul class="search-list" id="search-list" role="listbox" aria-labelledby="search-label" hidden></ul>
      <span id="search-status" role="status"></span>
    </div>
    {{- /* SHIPPED HIDDEN: app.js unhides Expand all and Collapse all on the
           expansion, full screen where the browser offers it, and Reset view
           wherever the zoom is wired, naming each in the wording's words.
           Wheel with Ctrl or Cmd, a pinch, drag, and + - 0 with focus in the
           chart zoom and pan it. */}}
    <div class="chart-tools" id="chart-tools">
      <button type="button" id="chart-expand-all" disabled hidden>{{.Wording.ExpandAll}}</button>
      <button type="button" id="chart-collapse-all" disabled hidden>{{.Wording.CollapseAll}}</button>
      <button type="button" id="chart-zoom-reset" disabled hidden>{{.Wording.ZoomReset}}</button>
      <button type="button" id="chart-fullscreen" hidden>{{.Wording.FullScreen}}</button>
    </div>
  </div>
  {{- /* WHAT THE FILTERS LEAVE OUT IS SAID BESIDE THE CHART, outside the
         rail, so a closed rail cannot hide that the chart is filtered. */}}
  <p class="filter-line" id="filter-line" aria-live="polite" hidden>
    <span id="filter-said"></span>
    <button type="button" id="filter-reset">Reset</button>
  </p>
  {{- /* The rail, the chart and the drawer, in reading order. app.js sets
         data-beside where the viewport has room for the rail beside the
         chart, and data-rail as the reader leaves the rail; without
         data-beside the three stack. The drawer is under the chart either
         way. */}}
  <div class="chart-body" id="chart-body">
  <div class="rail" id="rail">
    {{- /* SHIPPED HIDDEN: with JavaScript off there is nothing to collapse,
           and the rail's contents are shown. */}}
    <button type="button" class="rail-toggle" id="rail-toggle" aria-controls="rail-content" aria-expanded="true" hidden>{{.Wording.Rail}}</button>
    <div class="rail-content" id="rail-content">
    <span class="legend-head" id="legend-head" hidden>Follow one fund group's money</span>
    <div class="legend" id="legend" aria-labelledby="legend-head"></div>
    {{- /* SHIPPED HIDDEN AND EMPTY: what to show is the client's, so with
           JavaScript off these controls would change nothing. app.js fills the
           fund groups from the column on screen and the kinds from the page's
           kind labels, unhides the panel, and opens it where the rail opens. */}}
    <details class="filters" id="filters" hidden>
      <summary>Show and hide</summary>
      <fieldset class="filter-set">
        <legend>Fund groups</legend>
        <div class="filter-bulk">
          <button type="button" id="filter-all" aria-label="Show every fund group">All</button>
          <button type="button" id="filter-none" aria-label="Hide every fund group">None</button>
        </div>
        <div class="filter-list" id="filter-group-list"></div>
      </fieldset>
      <fieldset class="filter-set">
        <legend>Flow kinds</legend>
        <div class="filter-list" id="filter-kind-list"></div>
      </fieldset>
      <div class="filter-set filter-smallest">
        <label for="filter-smallest">Smallest flow drawn as itself</label>
        <input type="range" id="filter-smallest" min="0" max="0" step="1" value="0">
        <output id="filter-smallest-value" for="filter-smallest"></output>
      </div>
    </details>
    <div class="legend" aria-label="How to read the marks">
      <span><span class="key published" aria-hidden="true"></span> {{.Wording.PrintedByCity}}</span>
      <span><span class="key derived" aria-hidden="true"></span> {{.Wording.OurInference}} (dashed)</span>
    </div>
    </div>
  </div>
  <div class="chart-wrap">
    <div class="chart-scroll">
    <!-- role="group", not "img": the marks inside are focusable and named. -->
    <svg class="sankey" id="chart" role="group" aria-labelledby="chart-title chart-desc">
      {{- /* yearView's chart_title, which app.js repaints on a year switch. */}}
      <title id="chart-title">{{.ChartTitle}}</title>
      <desc id="chart-desc">
        {{- if .Description}}
        {{.Description}}
        {{- else}}
        Revenue categories flow into fund groups, which flow into object categories,
        transfers out and fund balance.
        {{- end}}
      </desc>
    </svg>
    </div>
    {{- /* THE CHART'S CAPTIONS, UNDER IT, SHIPPED HIDDEN AND EMPTY. Which
           splits a year switch folds back is the client's, since only it
           knows what the reader had split. */}}
    <p class="hairline-line" id="splits-line" aria-live="polite" hidden></p>
    {{- /* Which ribbons are under a pixel is the layout's, so app.js says
           how many are drawn as hairlines, and that a hairline is drawn wider
           than its share, wherever the chart has one. */}}
    <p class="hairline-line" id="hairline-line" aria-live="polite" hidden></p>
    <div class="tooltip" id="tooltip" role="status" aria-live="polite" hidden></div>
  </div>
  {{- /* THE DRAWER PREVIEWS WHAT IS HOVERED AND HOLDS WHAT IS PINNED: a
         click on a ribbon or a node, focus on one, or the drawer's own button
         pins it, and nothing hovered replaces a pin. */}}
  <aside class="drawer" id="drawer" aria-label="{{.Wording.Drawer}}">
    <div class="drawer-head">
      <button type="button" id="detail-follow" aria-pressed="false" hidden>{{.Wording.FollowMoney}}</button>
      <button type="button" id="detail-pin" aria-pressed="false" hidden>{{.Wording.Pin}}</button>
      <button type="button" id="detail-menu" aria-expanded="false" hidden>{{.Wording.NodeMenuMore}}</button>
    </div>
    <div class="detail" id="detail" aria-live="polite">
      <p class="subtle">{{.Wording.DetailEmpty}}</p>
    </div>
    {{- /* Empty until a year is drawn: what a click does depends on the chart
           drawn, so paintChartHint owns the words. */}}
    <p class="subtle chart-hint" id="chart-hint"></p>
  </aside>
  </div>
  <noscript>
    <p>
      This page draws its chart in the browser from
      <a href="{{.DataPath}}">{{.DataPath}}</a>, which holds every amount, fact id and source
      page.
    </p>
  </noscript>
</div>

{{- /* ON A NARROW SCREEN THE CHART GIVES WAY TO A POINTER: its labels would
       draw a few px tall. style.css shows the note and folds the card above
       it under its narrow media query; app.js shows the button, which puts
       the chart back for this visit. After the card, so the chart is still
       what the page opens on wherever it is drawn. */}}
{{- with .Narrow}}{{if .Path}}
<div class="narrow-note" id="narrow-note">
  <p>This flow chart needs a wider screen than this one to be read. <a href="{{.Path}}"{{with .YearKeys}} data-years="{{.}}"{{end}}>{{.Label}}</a> shows the same money as lists of bars, each opening into its parts.</p>
  <button type="button" id="narrow-show" hidden>Show the chart anyway</button>
</div>
{{- end}}{{end}}

{{- /* #hero and #lede-year are repainted per year by paintYearWords. */}}
<p class="lede">
  <span id="hero"><span class="label">{{.Hero.Label}}</span>: <strong class="value">{{.Hero.Value}}</strong></span>
  in the <span id="lede-year">{{.Lede}}</span> budget, all funds, gross, every figure traced to
  the city's published schedule.
</p>

<p class="subtle">
  {{- if .Description}}
  {{.Description}}
  {{- else}}
  Revenue on the left, fund groups in the middle, spending on the right; transfers between
  funds and fund balance are their own endpoints, not spending.
  {{- end}}
</p>
{{- /* Every year's caveats, so a year switch leaves the line true: a caveat
       with no node to flag (an empty applies_to) is in no drawer chip. */}}
{{- template "caveats-line" .CaveatsHere}}

{{- /* app.js repaints #counts-line. */}}
<p class="subtle"><span id="counts-line">◇ our count: {{.Links}} flows between {{.Nodes}} nodes, from {{.Facts}} facts</span></p>

</main>

{{- define "sources-heading"}}Sources for every year this page can show{{end}}
{{template "footer" .}}

<script src="vendor/d3.min.js"></script>
<script src="vendor/d3-sankey.min.js"></script>
<script>window.FISC_CONFIG = {{.ConfigJSON}};</script>
<!-- A module is deferred, so it runs after the classic scripts above; importing
     app.js runs nothing, so boot() is called here. -->
<script type="module">import { boot } from "./app.js"; boot();</script>
</body>
</html>
