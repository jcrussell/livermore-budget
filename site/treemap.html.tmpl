<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
<script type="application/json" id="sides-config">{{.ConfigJSON}}</script>
<script src="vendor/d3.min.js"></script>
<!-- A module is deferred, so it runs once the sections below are parsed;
     importing treemap.js runs nothing, so boot() is called here. -->
<script type="module">import { boot } from "./treemap.js"; boot(window);</script>
</head>
<body>

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">
      {{.Lede}} Drawn from the <span id="lede-year">{{.OpensLede}}</span> budget.
    </p>
  </div>
  <div class="head-controls">
    <label class="sides-year">Budget column
      <select id="year-select">
        {{- range .Years}}
        <option value="{{.Path}}"{{if eq .Path $.Opens}} selected{{end}}>{{.Lede}}</option>
        {{- end}}
      </select>
    </label>
  </div>
</header>

<main id="sides-main">

<p class="sides-how">
  Each side is a box of tiles, a tile's area its share of the side. Click a tile that opens to see its parts in place; click it again to close it. Shift-click opens a tile its other way where the budget prints one. A tile marked <em>inferred</em> is a figure the city prints only
  as a difference; one drawn hatched is printed as a reduction and counts
  against its parent. Every figure is a sum of cells the city printed, and the
  table below lists each with the page it was read from. A share marked ◇ is
  ours: one tile as a percentage of its side.
</p>

<ul class="sides-key" aria-label="Key">
  <li><span class="key-swatch can-open" aria-hidden="true"></span> opens with a click</li>
  <li><span class="key-swatch opened" aria-hidden="true"></span> opened; a click closes it</li>
  <li><span class="key-swatch reduction" aria-hidden="true"></span> printed as a reduction, drawn at its size</li>
  <li><span class="key-swatch derived" aria-hidden="true"></span> inferred: printed only as a difference</li>
</ul>

<div class="sides">
{{- range .Sides}}
<section class="sides-side" data-tier="{{.Tier}}" aria-labelledby="side-{{.Tier}}">
  <h2 id="side-{{.Tier}}">{{.Heading}}</h2>
  <p class="sides-total subtle"></p>
  {{- /* Hidden until the script fills it from the templates at the foot of
         main; with no script the table below carries nothing either, so
         the page says so. */}}
  <figure class="sides-figure" hidden></figure>
</section>
{{- end}}
</div>

<noscript><p class="refusal">This page draws its chart in the browser and lists every tile under it; with scripts off it shows neither. The same figures are on <a href="glance.html">the glance page</a>, which needs no script.</p></noscript>

<div class="tooltip" id="tooltip" role="status" aria-live="polite" hidden></div>

<details class="apparatus" id="table-view">
  <summary>
    <h3>Every tile as a table</h3>
    <span class="apparatus-hint"><span id="sides-count"></span></span>
  </summary>
  <div class="table-scroll">
  <table class="series-table sides-table" id="sides-table">
    <thead>
      <tr>
        <th scope="col">Side</th>
        <th scope="col">Tile</th>
        <th scope="col">Under</th>
        <th scope="col" class="num">Amount</th>
        <th scope="col" class="num">Share ◇</th>
        <th scope="col">Pages</th>
        <th scope="col">Note</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
  </div>
  <p class="subtle">The column drawn: <a id="sides-data-path" href="{{.Opens}}">{{.Opens}}</a>.</p>
</details>

{{- if .Caveats}}
<ul class="caveats">
  {{- range .Caveats}}
  <li>{{if .Href}}<a href="{{.Href}}">{{.Summary}}</a>{{else}}{{.Summary}}{{end}}</li>
  {{- end}}
</ul>
{{- end}}
{{- if .CaveatsPath}}
<p class="subtle">Every page's caveats are collected on <a href="{{.CaveatsPath}}">the caveats page</a>.</p>
{{- end}}

<!-- What the script clones per drawn piece, so the figure's markup lives
     here and the script fills figures in. -->
<template id="treemap-canvas">
  <svg class="treemap" role="group">
    <defs>
      <pattern id="sides-hatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
        <rect class="hatch-ground" width="6" height="6"/>
        <line class="hatch-line" x1="0" y1="0" x2="0" y2="6"/>
      </pattern>
    </defs>
  </svg>
</template>
<template id="treemap-tile"><svg><g class="tile" tabindex="0" role="button"><rect class="tile-box"/><rect class="tile-face" rx="3"/><text class="tile-label"></text><text class="tile-value"></text></g></svg></template>
</main>

<footer>
  {{template "sources" .}}
  <p class="subtle">
    Scope {{.Scope}}. Projection: {{.ProjectionBy}}. Packaged by {{.ExportedBy}}.
  </p>
</footer>

</body>
</html>
