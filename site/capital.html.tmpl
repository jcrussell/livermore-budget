{{define "description"}}Every project in the City of Livermore's Capital Improvement Program, by the fund paying for it, each figure linked to the page it was read from.{{end -}}
{{define "head-extra"}}
<!-- A module is deferred, so it runs once the table below is parsed; importing
     capital.js runs nothing, so boot() is called here. -->
<script type="module">import { boot } from "./capital.js"; boot(document);</script>{{end -}}
{{template "head" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<details class="how-to-read" open>
<summary>About these figures</summary>
<p class="lede">
  {{.Count}} printed project lines across {{len .Columns}} columns, {{.Facts}} figures in all,
  from the Budget Book's project listing by fund. Every figure is one the city printed and
  links to the extracted text of the page it was read from; a dash is a zero the page prints
  as a dash.
</p>
</details>

{{- template "caveats-line" .CaveatsHere}}

<!-- Hidden until capital.js binds it: with no script the whole table shows,
     and a control that does nothing is not offered. -->
<form class="capital-filters" id="capital-filters" hidden>
  <label>Fund
    <select id="capital-fund">
      <option value="">Every fund</option>
      {{- range .Funds}}
      <option value="{{.Number}}">{{.Label}}</option>
      {{- end}}
    </select>
  </label>
  <label>Project
    <input type="search" id="capital-search" placeholder="Search project names" autocomplete="off">
  </label>
  <p class="capital-shown" id="capital-shown" role="status"></p>
</form>

<div class="table-scroll">
<table class="series-table capital-table" id="capital-table" data-scope="{{.Scope}}">
  <caption>Capital projects by fund</caption>
  <thead>
    <tr>
      <th scope="col">Fund</th>
      <th scope="col">Project</th>
      {{- range $i, $c := .Columns}}
      <th scope="col" class="num{{if $c.New}} group-start{{end}}" data-column="{{$i}}" data-year="{{$c.Key}}" data-comparable-group="{{$c.Group}}">
        {{$c.Label}}<span class="basis">{{$c.Basis}}</span>
      </th>
      {{- end}}
    </tr>
  </thead>
  <tbody>
    {{- range .Rows}}
    <tr data-fund="{{.Fund}}">
      <td>{{.FundLabel}}</td>
      <th scope="row">{{.Project}}</th>
      {{- range $i, $c := .Cells}}
      <td class="num{{if $c.New}} group-start{{end}}{{if $c.Missing}} missing{{end}}" data-column="{{$i}}"{{if not $c.Missing}} data-cents="{{$c.Cents}}"{{end}}>
        {{- if $c.Missing}}
        <span title="This row is not printed in this column">{{$c.Value}}</span>
        {{- else}}
        <a href="{{$c.Href}}" title="Read on page {{$c.Page}}">{{$c.Value}}</a>
        {{- end}}
      </td>
      {{- end}}
    </tr>
    {{- end}}
  </tbody>
  <!-- Filled by capital.js: the sum of the rows shown, which is ours and is
       not the listing's printed TOTAL. -->
  <tfoot hidden>
    <tr class="capital-sum">
      <th scope="row" colspan="2">◇ Our sum of the rows shown</th>
      {{- range $i, $c := .Columns}}
      <td class="num{{if $c.New}} group-start{{end}}" data-column="{{$i}}"></td>
      {{- end}}
    </tr>
  </tfoot>
</table>
</div>

</main>

{{template "footer" .}}

</body>
</html>
