<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="Every reason a figure on this site does not say what it looks like it says, in full, with the document each one belongs to.">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
</head>
<body>

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<p class="lede">
  {{len .Entries}} caveat{{if ne (len .Entries) 1}}s{{end}}, each stated once, across {{.Documents}}
  published document{{if ne .Documents 1}}s{{end}}. Every page that shows figures links here in one
  line, to its own list below; each list links to the caveats in full further down.
</p>

{{- /* A view's section lists the caveats of every document it reaches
       (caveatsOfView), which is what that view's own line counts. */}}
{{- range .Views}}
<section class="caveat-page" id="{{.Anchor}}">
  <h2>On <a href="{{.Path}}">{{.Label}}</a></h2>
  <p class="subtle">{{len .Entries}} caveat{{if eq (len .Entries) 1}} applies{{else}}s apply{{end}} to this page.</p>
  <ul class="caveats">
    {{- range .Entries}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a></li>
    {{- end}}
  </ul>
</section>
{{- end}}

{{- if .Unviewed}}
<section class="caveat-page" id="caveats-in-data-no-page-draws">
  <h2>In data no page draws</h2>
  <p class="subtle">
    The site publishes some documents as data that no page draws yet. Their caveats are owed to
    whoever fetches the file, and repeat what a drawn year of the same schedule says.
  </p>
  <ul class="caveats">
    {{- range .Unviewed}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a></li>
    {{- end}}
  </ul>
</section>
{{- end}}

<section class="caveat-doc" aria-labelledby="caveats-in-full">
  <h2 id="caveats-in-full">In full</h2>
  {{- range .Entries}}
  <article class="caveat" id="{{.Anchor}}">
    <h3><a href="#{{.Anchor}}" class="anchor-link">{{.Summary}}</a></h3>
    <p>{{.Text}}</p>
    {{- range .About}}
    <p class="subtle">
      {{- if .AppliesTo}}
      About
      {{- range $i, $n := .AppliesTo}}{{if $i}},{{end}} <code>{{$n}}</code>{{end}} in
      {{- else}}
      Shipped inside
      {{- end}}
      {{- range $i, $f := .Files}}{{if $i}},{{end}} <a href="{{$f.DataPath}}">{{$f.DataPath}}</a> (<code>{{$f.Stem}}</code>)
      {{- end}}
      {{- if and .AppliesTo .Flagged}} — the chart flags these marks where it draws them{{end}}.
    </p>
    {{- end}}
    <p class="subtle">
      {{- if .Pages}}
      Stated on
      {{- range $i, $p := .Pages}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}.
      {{- else}}
      No page draws a document that carries it.
      {{- end}}
    </p>
  </article>
  {{- end}}
</section>

</main>

<footer>
  <!-- NO SOURCES LIST, and that is deliberate rather than missing. Every other
       page's footer cites the pages its figures were read from; this page shows
       no figures, so the union of every document's pages would be the broadest
       false provenance claim on the site. Each document links to itself above. -->
  {{- /* SO THIS DISCLOSURE HOLDS ONLY THE FILE LIST, and its id says so. Every
         other footer's holds a source list beside it; there is none to put
         here, for the reason stated directly above. */}}
  <details class="apparatus" id="data-view">
    <summary>
      <h3>The data</h3>
      <span class="apparatus-hint">{{len .Projections}} file{{if ne (len .Projections) 1}}s{{end}},
        each fetchable on its own</span>
    </summary>
    <p class="subtle">
      Every data file the site publishes:
      {{- range $i, $p := .Projections}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Path}}</a>{{end}}.
    </p>
  </details>
  <p class="subtle">
    Packaged by {{.ExportedBy}}. This page draws no projection and publishes no figure: it
    is what the other pages' figures do not say, collected so a reader can hold the whole set
    at once. Each caveat ships inside the document it belongs to, so it travels with the data
    rather than only with the page.
  </p>
</footer>

</body>
</html>
