<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="Every reason a figure on this site does not say what it looks like it says, in full, with the document each one belongs to.">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
</head>
<body class="prose-page">

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<p class="lede">
  {{len .Entries}} caveat{{if ne (len .Entries) 1}}s{{end}}, each stated once, across {{.Documents}}
  published document{{if ne .Documents 1}}s{{end}}. Every page that draws a schedule carrying a caveat
  links here in one line, to its own list below; each list links to the caveats in full further
  down.
</p>

{{- /* A view's section lists the caveats of every document it reaches
       (caveatsOfView), which is what that view's own line counts. */}}
{{- range .Views}}
<section class="caveat-page" id="{{.Anchor}}">
  <h2>On <a href="{{.Path}}">{{.Label}}</a></h2>
  <p class="subtle">{{len .Entries}} caveat{{if eq (len .Entries) 1}} applies{{else}}s apply{{end}} to this page.</p>
  <ul class="caveats">
    {{- range .Entries}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a>{{if .Of}} <span class="subtle">({{.Of}})</span>{{end}}</li>
    {{- end}}
  </ul>
</section>
{{- end}}

{{- if .Unviewed}}
<section class="caveat-page" id="caveats-in-data-no-page-draws">
  <h2>In data no page draws</h2>
  <p class="subtle">
    The site publishes some documents as data that no page draws yet. These caveats are carried
    only by those files, so no page above states them; they are owed to whoever fetches the file.
  </p>
  <ul class="caveats">
    {{- range .Unviewed}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a>{{if .Of}} <span class="subtle">({{.Of}})</span>{{end}}</li>
    {{- end}}
  </ul>
</section>
{{- end}}

<section class="caveat-doc" aria-labelledby="caveats-in-full">
  <h2 id="caveats-in-full">In full</h2>
  {{- range .Entries}}
  <article class="caveat" id="{{.Anchor}}">
    <h3><a href="#{{.Anchor}}" class="anchor-link">{{.Summary}}</a>{{if .Of}} <span class="subtle">({{.Of}})</span>{{end}}</h3>
    <p>{{.Text}}</p>
    {{- range .About}}
    <p class="subtle">
      {{- if .AppliesTo}}
      About
      {{- range $i, $n := .AppliesTo}}{{if $i}},{{end}} <code>{{$n}}</code>{{end}} in
      {{- else}}
      Shipped inside
      {{- end}}
      {{- range $i, $f := .Files}}{{if $i}},{{end}} <a href="{{$f.DataPath}}">{{$f.DataPath}}</a> (<code>{{$f.Stem}}</code>)
      {{- end}}
      {{- if and .AppliesTo .Flagged}} — the chart flags these marks where it draws them{{end}}.
    </p>
    {{- end}}
    <p class="subtle">
      {{- if .Pages}}
      Stated on
      {{- range $i, $p := .Pages}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}.
      {{- else}}
      No page draws a document that carries it.
      {{- end}}
    </p>
  </article>
  {{- end}}
</section>

</main>

{{template "footer" .}}

</body>
</html>
