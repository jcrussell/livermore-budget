<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="Every reason a figure on this site does not say what it looks like it says, in full, with the document each one belongs to.">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
{{template "theme-stamp"}}
</head>
<body class="prose-page">

<div class="wip-banner" role="status">⚠️ Work in progress — early preview, coverage is incomplete.</div>

{{template "topbar" .}}

<header class="page-head">
  <div>
    <h1>{{.Title}}</h1>
    <p class="lede">{{.Lede}}</p>
  </div>
</header>

<main>

<p class="lede">
  {{len .Entries}} caveat{{if ne (len .Entries) 1}}s{{end}}, each stated once, across {{.Documents}}
  published document{{if ne .Documents 1}}s{{end}}, in {{len .Themes}} kind{{if ne (len .Themes) 1}}s{{end}}.
</p>

<section class="caveat-themes" aria-labelledby="caveats-kinds">
  <h2 id="caveats-kinds">The kinds</h2>
  <dl class="caveat-kinds">
    {{- range .Themes}}
    <dt><a href="#{{.Anchor}}">{{.Heading}}</a> <span class="subtle">({{len .Entries}})</span></dt>
    <dd>{{.Blurb}}</dd>
    {{- end}}
  </dl>
</section>

{{- /* A section lists the caveats of every document its views reach
       (caveatsOfView), which is what each view's own line counts; views
       stating the same caveats share one. */}}
{{- range .Sections}}
<section class="caveat-page" id="{{.Anchor}}">
  <h2>On {{range $i, $p := .Pages}}{{if $i}} and {{end}}<a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}</h2>
  {{- range .Groups}}
  <h3 id="{{.Anchor}}">{{.Heading}}</h3>
  <ul class="caveats">
    {{- range .Entries}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a></li>
    {{- end}}
  </ul>
  {{- end}}
</section>
{{- end}}

{{- if .Unviewed}}
<section class="caveat-page" id="caveats-in-data-no-page-draws">
  <h2>In data no page states caveats for</h2>
  <p class="subtle">
    These are carried only by documents no page above lists caveats for: schedules no page draws
    yet, and the finer schedules a chart opens into when you click through. They are owed to
    whoever fetches the file.
  </p>
  <ul class="caveats">
    {{- range .Unviewed}}
    <li><a href="#{{.Anchor}}">{{.Summary}}</a></li>
    {{- end}}
  </ul>
</section>
{{- end}}

{{- range .Themes}}
<section class="caveat-doc" id="{{.Anchor}}" aria-labelledby="{{.Anchor}}-h">
  <h2 id="{{.Anchor}}-h">{{.Heading}}</h2>
  {{- range .Entries}}
  <article class="caveat" id="{{.Anchor}}">
    <h3><a href="#{{.Anchor}}" class="anchor-link">{{.Summary}}</a></h3>
    {{- range .Variants}}
    <div class="caveat-variant">
    <p>{{if .Of}}<strong>{{.Of}}:</strong> {{end}}{{.Text}}</p>
    {{- range .About}}
    <p class="subtle">
      {{- if .AppliesTo}}
      About
      {{- range $i, $n := .AppliesTo}}{{if $i}},{{end}} <code>{{$n}}</code>{{end}} in
      {{- else}}
      Shipped inside
      {{- end}}
      {{- range $i, $f := .Files}}{{if $i}},{{end}} <a href="{{$f.DataPath}}">{{$f.DataPath}}</a> (<code>{{$f.Stem}}</code>)
      {{- end}}
      {{- if and .AppliesTo .Flagged}} — the chart flags these marks where it draws them{{end}}.
    </p>
    {{- end}}
    </div>
    {{- end}}
    <p class="subtle">
      {{- if and .Pages .Checked}}
      Checked for
      {{- range $i, $p := .Pages}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}.
      {{- else if .Pages}}
      Stated on
      {{- range $i, $p := .Pages}}{{if $i}},{{end}} <a href="{{$p.Path}}">{{$p.Label}}</a>{{end}}.
      {{- else if .DataFiles}}
      Stated on no page: it is about adding up a downloaded file.
      {{- else}}
      No page states it: see "In data no page states caveats for".
      {{- end}}
    </p>
  </article>
  {{- end}}
</section>
{{- end}}

</main>

{{template "footer" .}}

</body>
</html>
