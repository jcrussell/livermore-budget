    "caveats": [
      {
        "id": "transfer-legs-unpaired",
        "summary": "No link pairs a transfer's two legs; transfers out exceed transfers in by $50,762,251, which the city prints as its own column.",
        "text": "Transfer legs are unpaired IN THIS DOCUMENT: no link here carries a transfer_id. Budget Book p76's transfers are published one document over, in transfers-by-fund, which draws each end of every figure p76 prints as its own link under one transfer_id, and this chart's Transfers In opens into it. They are not added here because revenue-by-fund publishes transfer_in over the same money, and a document carrying both would have to say which schedule it reads that money from. Transfers out ($72,386,884) exceed transfers in ($21,624,633), and the $50,762,251 difference is not an unexplained gap: the city prints it as a column of its own, \"Transfers Out to CIP\", on the sources-and-uses schedule at PDF p75 -- with p76's grand total printed beside it as the transfers-out figure that excludes the CIP. Only the citywide total is published: splitting it by fund group is our arithmetic, because that schedule prints one aggregate for every non-major fund. It is stated as headline.transfer_residual_cents rather than netted away or padded with an invented link.",
        "applies_to": [
          "transfers/in",
          "transfers/out"
        ]
      },
      {
        "id": "internal-service-is-outside-the-external-headline",
        "summary": "Internal Service charges are billed between city departments, so they are outside the external headline.",
        "text": "Internal Service Fund charges are billed to other City departments, so they are classified internal_service and excluded from the external headline. The all_funds_gross figures include them and match the city's own citywide totals.",
        "applies_to": [
          "fund-group/internal-service"
        ]
      },
      {
        "id": "contested-total-internal-service",
        "summary": "The city's own book prints two different figures for Internal Service Funds expenditure, $250,000 apart; this chart draws the one on pp.66-67.",
        "text": "THE CITY'S OWN BOOK DISAGREES WITH ITSELF ABOUT THIS ONE FIGURE. Internal Service Funds expenditure is drawn at $26,544,515, which is what pp.66-67 print for FY2027 adopted. Other schedules in the same document make it $26,294,515: p0183, p0075, p0205 and p0209 print that figure, and p0061 prints $26,906,515, which is that figure plus the $612,000 transfer to the CIP it prints beside it, and the 78 rows of pp.85-125 sum to it. The difference is $250,000, in a single Services & Supplies row. This chart draws the spine's figure because every figure here is one the city printed on the page it is cited from, and substituting a number from elsewhere would make this one an exception to that. Which figure the corpus should publish is open (fisc-av0w).",
        "applies_to": [
          "fund-group/internal-service"
        ]
      },
      {
        "id": "working-capital-is-a-stock",
        "summary": "Beginning and ending working capital are stocks, not flows, so the chart carries no link for them.",
        "text": "The Sankey shows flows only. BEGINNING and ENDING WORKING CAPITAL are stocks and are recorded as facts but carry no link, so the chart will not reconcile row-for-row against pp.66-67.",
        "applies_to": []
      },
      {
        "id": "permanent-funds-have-no-column",
        "summary": "Permanent Funds are a seventh fund type, and this schedule prints no column for them.",
        "text": "Permanent Funds are a seventh fund type in data/funds.yaml (2 funds) with no column on this schedule.",
        "applies_to": []
      }
    ]
  },
